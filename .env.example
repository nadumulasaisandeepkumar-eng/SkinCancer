# API Configuration
# Base URL for the Hugging Face Space - update before deploying
# Format: https://your-username-your-space-name.hf.space
VITE_API_BASE_URL=https://hf.space/placeholder

# Application metadata
VITE_APP_NAME=DermAI Clinical

# Toggle: set to 'true' to use mock data instead of real API
# Set to 'false' when connecting the real trained model backend
VITE_ENABLE_MOCK_API=true
